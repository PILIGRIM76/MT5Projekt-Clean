# Genesis Trading System - Production Environment
# Скопируйте этот файл в .env и заполните значения

# MT5 Connection
MT5_LOGIN=53057252
MT5_PASSWORD=ваш_пароль
MT5_SERVER=Alpari-MT5-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Trading Mode
TRADING_MODE=production
LIVE_TRADING=true
AUTO_TRADING=true
DEV_MODE=false

# Database Configuration
POSTGRES_USER=genesis_user
POSTGRES_PASSWORD=ваш_надежный_пароль
POSTGRES_DB=genesis_trading
DATABASE_URL=postgresql://genesis_user:ваш_надежный_пароль@localhost:5432/genesis_trading

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ваш_redis_пароль

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=ваш_ключ_api

# Telegram Bot
TELEGRAM_BOT_TOKEN=ваш_токен_бота
TELEGRAM_CHAT_ID=ваш_chat_id

# Finnhub API (Market Data)
FINNHUB_API_KEY=ваш_finnhub_ключ

# Risk Management
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
STOP_LOSS_MULTIPLIER=1.5
TAKE_PROFIT_MULTIPLIER=2.0

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs

# ML Models
AI_MODELS_PATH=./ai_models
DEFAULT_MODEL_NAME=genesis_trading_v3